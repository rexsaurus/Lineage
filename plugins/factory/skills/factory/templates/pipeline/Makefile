# {{title}} — generated by the factory from pipeline.yaml.
#   make fixture                  check and build the fixture project (proves the pipeline works)
#   make new PROJECT=path         start a real project
#   make status|check|questions|draft|final PROJECT=path
SHELL   := /bin/bash
HOME_   := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
PY      ?= python3
PL      := $(HOME_)/scripts/pl.py
export PIPELINE_HOME := $(HOME_)
override PROJECT := $(patsubst ~/%,$(HOME)/%,$(PROJECT))

.PHONY: fixture new status check questions draft final

fixture:
	@cd $(HOME_)/fixture && $(PY) $(PL) ingest && $(PY) $(PL) check && $(PY) $(PL) build && $(PY) $(PL) status

new:
	@test -n "$(PROJECT)" || { echo "usage: make new PROJECT=path"; exit 1; }
	@mkdir -p "$(PROJECT)" && cd "$(PROJECT)" && $(PY) $(PL) init

status check questions:
	@test -n "$(PROJECT)" || { echo "set PROJECT=path"; exit 1; }
	@cd "$(PROJECT)" && $(PY) $(PL) $@

draft:
	@test -n "$(PROJECT)" || { echo "set PROJECT=path"; exit 1; }
	@cd "$(PROJECT)" && $(PY) $(PL) build

final:
	@test -n "$(PROJECT)" || { echo "set PROJECT=path"; exit 1; }
	@cd "$(PROJECT)" && $(PY) $(PL) build --final
