# Lineage web: every setting (validated in src/env.ts). Copy to .env.local for local runs.
# Defaults give a safe local setup: no price shown, fake payments, email written to .data/outbox, files in .data/blobs.

APP_URL=http://localhost:3000
SESSION_SECRET=                      # 32+ random characters (openssl rand -base64 48); REQUIRED in production

# Database: leave empty to use the embedded PGlite in .data/pglite; set for Neon / Vercel Postgres
DATABASE_URL=

# Offer. Never show a price until Rex sets one.
PRICE_TBD=true
PRICE_DISPLAY=                       # e.g. what appears after "Founding Archivist —"; required when PRICE_TBD=false

# Payments: "fake" (local, no network) or "stripe" (TEST keys sk_test_…; live keys are refused unless ALLOW_LIVE_STRIPE=true)
PAYMENTS_DRIVER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FOUNDING=
STRIPE_PAYMENT_LINK_URL=             # optional fallback (admin toggle)
ALLOW_LIVE_STRIPE=false

# Family subscriptions. Until a price is set, relatives can only follow, free.
SUB_PRICE_TBD=true
SUB_PRICE_DISPLAY=                   # the text after "Subscribe —"; required when SUB_PRICE_TBD=false
STRIPE_PRICE_ID_FAMILY_SUB=          # a recurring Price (test mode)

# Archivist referral earnings. No defaults: unset = not open / not decided.
REV_SHARE_PCT=                       # e.g. 20 or 12.5
REFUND_HOLD_DAYS=                    # days before an earning can be paid out
MIN_PAYOUT_CENTS=                    # smallest payout; unset = no minimum
PAYOUT_CRON_ENABLED=false            # true: also pay everyone due on the 1st of the month
CONNECT_DRIVER=fake                  # "fake" (local) or "stripe" (Connect Express, test keys)
FAKE_SUB_AMOUNT_CENTS=               # fake driver only: what a fake subscription invoice charges
FAKE_SUB_CURRENCY=usd

# Email: "console" (writes .data/outbox/*.json, sends nothing) or "resend"
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Rex at Lineage <rex@example.org>
MAIL_REPLY_TO=

# Files: "local" (.data/blobs) or "r2" (Cloudflare R2, private bucket)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Admin
ADMIN_EMAILS=                        # comma-separated; these accounts see /admin and are left out of every count
KPI_EXPORT_TOKEN=                    # 24+ characters, for scripts/append-kpi.ts
CRON_SECRET=                         # 16+ characters; Vercel Cron sends it as a Bearer token
